# pixi environments
.pixi
*.egg-info

# Python bytecode
__pycache__/
*.pyc

# IDE
.idea/

# Apptainer/Singularity images
*.sif

# large data files (see README: hosted at the 4TU deposit)
/data/TCGA_complete_bp_top1k.csv.gz
/data/goa_human.gaf

# SLURM job logs (job scripts themselves are tracked)
/slurm/out/

# Figure inputs: 12 GB, downloaded from the 4TU deposit (see figures/README.md)
/figures/data/*
!/figures/data/.gitkeep

# Regenerated intermediates from figures/src/prepare/
/figures/out/prepare/

# Packaged copy of figures/data/ for the 4TU deposit -- never commit
figures/source_data_for_figures.zip

# PNGs are regenerated by every figure run; only the PDFs are committed
/figures/out/*.png
/figures/out/*.csv
